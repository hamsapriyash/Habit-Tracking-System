generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String?
  email     String   @unique
  password  String
  habits    Habit[]  // This links the user to their habits
  createdAt DateTime @default(now())
}

model Habit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  time      String
  createdAt DateTime @default(now())

  // This connects each habit to a specific user
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  
  ticks     Tick[]
}

model Tick {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  habitId   String   @db.ObjectId
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  day       Int
  month     Int
  year      Int
  createdAt DateTime @default(now())

  @@unique([habitId, day, month, year])
}